# Optional local settings. Copy this file to .env and fill in only what you use.
# Keep .env private; never commit credentials or API keys.

# Optional application paths and port
# YTDL_DATA_DIR=
# YTDL_DOWNLOADS_DIR=
# YTDL_PORT=5000

# Docker only: folder on this PC where downloaded videos are saved
# (default: the "downloads" folder next to Start.bat). Example:
# HOST_DOWNLOADS_DIR=D:/Videos

# Google Drive and Picker setup (optional)
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
